# cs408 环境变量示例。
# 复制为 .env.local 并填入真实值；.env.local 已被 .gitignore 忽略，请勿提交。
#   cp .env.example .env.local

# 登录初始密码（首次启动创建单用户账号时使用）
STUDY_INITIAL_PASSWORD=change-me

# 主观题批改网关（vyceai，OpenAI 兼容接口）
GRADE_BASE_URL=https://vyceai.com/v1
GRADE_API_KEY=sk-your-key
GRADE_MODEL=gpt-5.6-luna

# 会话签名密钥
SESSION_SECRET=change-me

# 后端端口
STUDY_PORT=8408

# 手机扫码上传草稿纸时，二维码里写的对外地址。
# 留空 = 自动探测本机局域网 IP（本地开发用，手机需与电脑同网）。
# 部署到公网后必须填，否则会探测成服务器内网地址（如云主机的 10.x），手机打不开。
#   例：STUDY_PUBLIC_BASE=https://408.xpliang.tech
STUDY_PUBLIC_BASE=
