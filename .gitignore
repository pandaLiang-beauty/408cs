# cs408 忽略清单

# 本地环境变量（含密钥），仅保留 .env.example
.env.local

# Python
**/__pycache__/
*.pyc
backend/.venv/

# 运行期数据（题库原始 HTML / 草稿 / SQLite 库与 WAL 边车文件）
# study.db 内含在线配置的大模型密钥与密码哈希，绝不入库
backend/data/*.db
backend/data/raw/
backend/data/raw_sim/
backend/data/drafts/
backend/data/*.db-wal
backend/data/*.db-shm

# 前端
frontend/node_modules/
frontend/dist/

# 日志与运行期 pid
*.log
server.pid
